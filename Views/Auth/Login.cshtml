@model UserModel
@{
    ViewData["Title"] = "Login";
}

<div class="text-center">
    <h1 class="display-4">Entre em sua conta</h1>
    <form asp-controller="Auth" asp-action="Login" method="post">
        <label for="email">
            <p>Email:</p>
             <input type="email" asp-for="Email" name="email" value="" id="email" />
        </label>
        <label for="password">
            <p>Senha:</p>
            <input type="password" asp-for="Password" name="password" value="" id="password" />
        </label>
        <input type="submit" value="ENTRAR" />
    </form>
</div>
