@model Tuple<List<TicketModel>,List<UserModel>>

@{
    ViewData["Title"] = "Tickets a designar";
}

<div class="text-center">
    <h1 class="display-4">Tickets</h1>
    <table class="table">
        <thead>
            <tr>
                <th scope="col">Titulo</th>
                <th scope="col">Descrição</th>
                <th scope="col">Ações</th>
            </tr>
        </thead>
        <tbody>
            @if(Model != null && Model.Item1.Count >0 )
            {
                @foreach (TicketModel ticket in Model.Item1)
                {
                    <tr>
                        <td>@ticket.Title</td>
                        <td>@ticket.Description</td>

                        <td>
                            <div class="dropdown">

                                @{
                                    var dropdownId = $"dropdownTicket{ticket.Id}";
                                }

                                @if (ticket.AssignedEmployee != null)
                                {
                                    <button class="btn btn-secondary dropdown-toggle"
                                            type="button"
                                            id="@dropdownId"
                                            data-bs-toggle="dropdown"
                                            aria-expanded="false">
                                        @ticket.AssignedEmployee.Name
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-secondary dropdown-toggle"
                                            type="button"
                                            id="@dropdownId"
                                            data-bs-toggle="dropdown"
                                            aria-expanded="false">
                                        Selecionar funcionário
                                    </button>
                                }

                                <div class="dropdown-menu"
                                     aria-labelledby="@dropdownId">

                                    @if (Model.Item2 != null && Model.Item2.Count > 0)
                                    {
                                        foreach (UserModel user in Model.Item2)
                                        {
                                            <form asp-controller="Tickets"
                                                  asp-action="AlterarFuncionario"
                                                  method="post">

                                                <input type="hidden"
                                                       name="ticketId"
                                                       value="@ticket.Id" />

                                                <input type="hidden"
                                                       name="userId"
                                                       value="@user.Id" />

                                                <button type="submit"
                                                        class="dropdown-item">
                                                    @user.Name
                                                </button>

                                            </form>
                                        }
                                    }

                                </div>

                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
